# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
# development | production   (production enables extra security checks)
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Use a dedicated DB user with a STRONG password and restrict Atlas Network Access.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/medfit?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The two secrets MUST be different and MUST NOT be dictionary/keyboard words.
# In production the server refuses to boot if these are weak or equal.
JWT_SECRET=change-me-to-a-64+-char-random-hex-string
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-me-to-a-DIFFERENT-64+-char-random-hex-string
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cookies ──────────────────────────────────────────────────────────────────
# MUST be true in production (HTTPS-only cookies). Auto-forced true when
# NODE_ENV=production. Keep false for local http://localhost testing.
COOKIE_SECURE=false

# ─── Frontend origin (CORS) ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Email (password-reset OTP) ───────────────────────────────────────────────
# Provider-agnostic SMTP. In DEVELOPMENT, if these are missing/unreachable the
# app falls back to Ethereal (prints a preview URL — no real email sent).
# In PRODUCTION a working SMTP is required (no fallback).
#
# Pick ONE provider below and paste its SMTP credentials.
#
# ── Resend (recommended — simple, good deliverability) ──
#   EMAIL_HOST=smtp.resend.com
#   EMAIL_PORT=587
#   EMAIL_SECURE=false
#   EMAIL_USER=resend
#   EMAIL_PASS=re_xxxxxxxxxxxxxxxxx           # your Resend API key
#   EMAIL_FROM="MedFit Clinic <noreply@yourdomain.com>"
#
# ── SendGrid ──
#   EMAIL_HOST=smtp.sendgrid.net
#   EMAIL_PORT=587
#   EMAIL_SECURE=false
#   EMAIL_USER=apikey
#   EMAIL_PASS=SG.xxxxxxxx                     # your SendGrid API key
#   EMAIL_FROM="MedFit Clinic <noreply@yourdomain.com>"
#
# ── Amazon SES (SMTP interface) ──
#   EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
#   EMAIL_PORT=587
#   EMAIL_SECURE=false
#   EMAIL_USER=YOUR_SES_SMTP_USERNAME
#   EMAIL_PASS=YOUR_SES_SMTP_PASSWORD
#   EMAIL_FROM="MedFit Clinic <noreply@yourdomain.com>"
#
# ── Gmail (OK for testing / very low volume only — NOT recommended for prod) ──
#   Requires 2-Step Verification + a 16-char App Password (not your login password).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM="MedFit Clinic <your@gmail.com>"

# ─── Clinic letterhead (printed on PDF certificates) ──────────────────────────
CLINIC_NAME=NAVODAYA CLINIC
CLINIC_TAGLINE=Seamless Care
CLINIC_ADDRESS=Shiv Lane, Next to Prakash Furniture, Rahatani.
CLINIC_PHONE=8451044222
